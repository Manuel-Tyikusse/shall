# --- Infraestrutura (preenchido por quem faz o deploy — NÃO é pedido pelo `shall init`) ---

# Twilio (console.twilio.com) — voz e SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+xxxxxxxxxxxxx
CALL_RING_TIMEOUT_SECONDS=30

# URL público onde este servidor está acessível (Twilio precisa de o alcançar)
PUBLIC_URL=https://xxxxxxxxxxxxxxxxxx #you can use ngrok or similar to expose your local server
PORT=3300

# Timeouts de aprovação
APPROVAL_TIMEOUT_MS=120000
MAX_CLARIFICATION_ATTEMPTS=3

# CouchDB — docker run -d -p 5984:5984 -e COUCHDB_USER=admin -e COUCHDB_PASSWORD=password couchdb
COUCHDB_URL=#your couchdb url, e.g. http://admin:password@localhost:5984
#create those dbs in your couchdb instance:
COUCHDB_ACTIVITY_DB=agent_guard_activity
COUCHDB_APPROVALS_DB=agent_guard_approvals
COUCHDB_TEAM_DB=agent_guard_team
COUCHDB_CLASSIFICATION_CACHE_DB=agent_guard_classification_cache
COUCHDB_TENANTS_DB=agent_guard_tenants
CLASSIFICATION_CACHE_TTL_MS=86400000

# Google Gemini — classificação de comandos, decisões e assistente do projeto
GEMINI_API_KEY=AQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=#try with any available Gemini model, e.g. gemini-3.8-flash

