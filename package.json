{
  "name": "shall",
  "version": "0.1.0",
  "description": "CLI que classifica comandos de agentes de código através de hooks pré-execução.",
  "type": "module",
  "bin": {
    "shall": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node --test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@google/genai": "^2.24.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "nano": "^11.0.7",
    "nanoid": "^5.0.7",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "twilio": "^5.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
